{
  "name": "gradsun",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:spell": "cspell --no-progress \"**\" --config cspell.json",
    "check:guardrails": "tsx scripts/guardrails.ts",
    "prisma:generate": "prisma generate --schema=src/infrastructure/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/infrastructure/prisma/schema.prisma",
    "prisma:seed": "tsx src/infrastructure/prisma/seed.ts",
    "prisma:studio": "prisma studio --schema=src/infrastructure/prisma/schema.prisma",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run check:spell && npm run check:guardrails && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^7.0.2",
    "@prisma/client": "^6.4.1",
    "@swc/helpers": "^0.5.24",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.16",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.68.0",
    "next": "^15.2.0",
    "next-intl": "^4.14.9",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.8.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^11.0.0",
    "@types/web-push": "^3.6.4",
    "cspell": "^10.4.0",
    "happy-dom": "^21.0.4",
    "oxc-parser": "^0.157.0",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  }
